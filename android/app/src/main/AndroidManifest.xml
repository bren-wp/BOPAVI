<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <application android:appCategory="game" android:enableOnBackInvokedCallback="true" android:allowBackup="false" android:label="BOPAVI" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:theme="@style/BopaviTheme" android:usesCleartextTraffic="false" android:supportsRtl="true">
